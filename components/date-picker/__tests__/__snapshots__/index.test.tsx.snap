    <div
      className="kd-date-picker-panel bottomLeft bottomLeft-active"
      style={
        Object {
          "position": "absolute",
        }
      }
    >
      <div
        onMouseDown={[Function]}
      >
        <Panel
          allowClear={true}
          autoFocus={false}
          borderType="underline"
          defaultOpen={false}
          disabled={false}
          format="yyyy"
          hourStep={1}
          inputReadOnly={false}
          minuteStep={1}
          onChange={[Function]}
          open={true}
          picker="year"
          popupStyle={Object {}}
          secondStep={1}
          showArrow={true}
          showToday={false}
          showWeeksTitle={true}
          size="middle"
          style={Object {}}
          value={1999-12-31T16:00:00.000Z}
          yearItemNumber={15}
        >
          <div
            className="kd-date-picker-warpper"
          >
            <Header
              className="kd-date-picker-header kd-date-picker-header-year"
              onSuperNext={[Function]}
              onSuperPrev={[Function]}
            >
