    <div
      className="kd-date-picker-panel bottomLeft bottomLeft-active"
      style={
        Object {
          "position": "absolute",
        }
      }
    >
      <div
        className="kd-date-picker-container"
        onMouseDown={[Function]}
      >
        <div>
          <div
            className="kd-date-picker-container-date"
          >
            <Panel
              allowClear={true}
              allowEmpty={
                Array [
                  false,
                  false,
                ]
              }
              autoFocus={false}
              borderType="underline"
              defaultOpen={false}
              disabled={false}
              disabledDate={[Function]}
              hourStep={1}
              inputReadOnly={false}
              mergedActivePickerIndex={0}
              minuteStep={1}
              open={true}
              order={true}
              picker="date"
              popupStyle={Object {}}
              secondStep={1}
              separator="~"
              showArrow={true}
              showWeeksTitle={true}
              size="middle"
              suffixIcon={
                <div>
                  suffixIcon
                </div>
              }
              value={
                Array [
                  2000-09-30T16:00:00.000Z,
                  2000-10-31T04:00:00.000Z,
                ]
              }
            >
              <div
                className="kd-date-picker-warpper"
              >
                <Header
                  className="kd-date-picker-header kd-date-picker-header-date"
                  onPrev={[Function]}
                  onSuperPrev={[Function]}
                >
                  <div
                    className="kd-date-picker-header kd-date-picker-header-date"
                  >
                    <span
                      className="kd-date-picker-header-icon"
                      onClick={[Function]}
                    >
                      <Icon
                        type="double-arrow-left"
                      >
                        <i
                          className="kdicon kdicon-double-arrow-left"
                          onClick={[Function]}
                          onMouseEnter={[Function]}
                          onMouseLeave={[Function]}
                          style={Object {}}
                        />
                      </Icon>
                    </span>
                    <span
                      className="kd-date-picker-header-icon"
                      onClick={[Function]}
                    >
                      <Icon
                        type="arrow-left"
                      >
                        <i
                          className="kdicon kdicon-arrow-left"
                          onClick={[Function]}
                          onMouseEnter={[Function]}
                          onMouseLeave={[Function]}
                          style={Object {}}
                        />
                      </Icon>
                    </span>
                    <span
                      className="kd-date-picker-header-text"
                    >
                      <span
                        className="kd-date-picker-header-text-inner kd-date-picker-header-text-inner-hover"
                        onClick={[Function]}
                      >
                        2000年
                      </span>
                      <span
                        className="kd-date-picker-header-text-inner kd-date-picker-header-text-inner-hover"
                        onClick={[Function]}
                      >
                        10月
                      </span>
                    </span>
                    <span
                      className="kd-date-picker-header-icon"
                    />
                    <span
                      className="kd-date-picker-header-icon"
                    />
                  </div>
                </Header>
                <Calendar
                  disabledDate={[Function]}
                  picker="date"
                  showWeeksTitle={true}
                >
                  <div
                    className="kd-date-picker-calendar"
                  >
                    <div
                      className="kd-date-picker-weektitle"
                    >
                      <div
                        className="kd-date-picker-weektitle-item"
                        key="0"
                      >
                        日
                      </div>
                      <div
                        className="kd-date-picker-weektitle-item"
                        key="1"
                      >
                        一
                      </div>
                      <div
                        className="kd-date-picker-weektitle-item"
                        key="2"
                      >
                        二
                      </div>
                      <div
                        className="kd-date-picker-weektitle-item"
                        key="3"
                      >
                        三
                      </div>
                      <div
                        className="kd-date-picker-weektitle-item"
                        key="4"
                      >
                        四
                      </div>
                      <div
                        className="kd-date-picker-weektitle-item"
                        key="5"
                      >
                        五
                      </div>
                      <div
                        className="kd-date-picker-weektitle-item"
                        key="6"
                      >
                        六
                      </div>
                    </div>
                    <div
                      className="kd-date-picker-calendar-warpper"
